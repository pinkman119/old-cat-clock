# 复制为 .env 后按需修改；不配置时全部使用下列默认值
MAOMAO_SERVER_PORT=3000

# PostgreSQL（docker-compose 起的 maomao-postgres 容器）
DATABASE_URL=postgresql://maomao:maomao123@127.0.0.1:15432/maomao_clock?schema=public

# JWT 签名密钥，生产环境务必替换为随机长字符串
MAOMAO_JWT_SECRET=change-this-secret-in-production
MAOMAO_JWT_EXPIRES=30d

# 首次启动时自动创建的管理员账号（密码以 scrypt 哈希写入 PostgreSQL）
# 生产部署时该账号同时用于登录管理后台与 Electron 客户端
MAOMAO_ADMIN_USERNAME=huimin
MAOMAO_ADMIN_PASSWORD=20001024

# 可选：管理后台静态产物目录，Docker 部署时由编排注入，同源提供 /api 与后台页面
# MAOMAO_ADMIN_DIST=/app/admin-dist

# 可选：客户端安装包存放目录（默认 apps/server/storage/client-releases）与单文件大小上限（MB，默认 300）
# 生产部署请把该目录挂到持久卷，避免重启或重新部署后安装包丢失
# MAOMAO_CLIENT_RELEASES_DIR=/data/client-releases
# MAOMAO_CLIENT_MAX_SIZE_MB=300
