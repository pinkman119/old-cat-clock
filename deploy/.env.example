# 复制为 deploy/.env 后按实际服务器情况修改。
# build.sh / build.ps1 会把它复制到 output/deploy.env；服务器上真正生效的是 output/deploy.env。

# 对外端口：管理后台与 API 同源，客户端也连这个端口
HOST_PORT=3000

# 构建出的镜像名（本地 save 与服务器 load 使用同一个 tag）
IMAGE_NAME=maomao-clock:0.1.0

# 可选：本地构建镜像时使用的 npm 源，国内网络可取消注释加速
# NPM_REGISTRY=https://registry.npmmirror.com

# PostgreSQL（仅容器内网访问，不映射到宿主机）
POSTGRES_USER=maomao
POSTGRES_PASSWORD=maomao123
POSTGRES_DB=maomao_clock

# 生产环境务必改成随机长字符串
MAOMAO_JWT_SECRET=change-this-secret-before-deploy
MAOMAO_JWT_EXPIRES=30d

# 唯一账号：同时用于登录管理后台与 Electron 客户端
MAOMAO_ADMIN_USERNAME=huimin
MAOMAO_ADMIN_PASSWORD=20001024

# 后台上传的客户端安装包：单个文件大小上限（MB），文件保存在持久卷中
MAOMAO_CLIENT_MAX_SIZE_MB=300

# 服务器实际公网 IP 或域名，build-client.ps1 会读取它来打包客户端
# 例如：SERVER_IP=192.168.1.10
SERVER_IP=
